{
  "name": "garmin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@garmin/fitsdk": "^21.221.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4"
  },
  "platform": {
    "kind": "mcp",
    "description": "Read-only MCP server for Garmin Connect data, used from claude.ai.",
    "autoDeploy": false,
    "protectedVars": [
      "MCP_SERVER_URL",
      "ALLOWED_GITHUB_USER_ID"
    ],
    "smoke": [
      {
        "path": "/.well-known/oauth-protected-resource/mcp",
        "status": 200,
        "contains": "https://garmin-mcp.tsutsu.dev/mcp"
      }
    ]
  }
}
