{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "garmin-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-04",
	// global_fetch_strictly_public is required for OAuth Client ID Metadata Documents.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		// The GitHub account allowed through login (numeric id of "ortix").
		"ALLOWED_GITHUB_USER_ID": "1493849",
		// The exact URL pasted into claude.ai. Overridden in .dev.vars for local dev.
		"MCP_SERVER_URL": "https://garmin-mcp.tsutsu.dev/mcp"
	},
	// Served only on the custom domain: tokens are bound to MCP_SERVER_URL, so
	// workers.dev and preview URLs would just answer 401s.
	"routes": [{ "pattern": "garmin-mcp.tsutsu.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"kv_namespaces": [
		{ "binding": "OAUTH_KV", "id": "5b517f1ce6ca4e0ea395beebcfc43131" },
		{ "binding": "GARMIN_CACHE", "id": "87b5bc8f50f24674a8477a44b6aaca03" }
	],
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}
